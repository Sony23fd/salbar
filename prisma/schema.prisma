generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(cuid())
  phone                String?         @unique
  email                String?         @unique
  password             String?
  name                 String?
  role                 Role            @default(CUSTOMER)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  canViewOtherBranches Boolean         @default(false)
  address              String?
  referralCode         String?         @unique
  referralCount        Int             @default(0)
  referralReward       Int             @default(0)
  referredById         String?
  cart                 Cart?
  orders               Order[]
  referredBy           User?           @relation("UserReferrals", fields: [referredById], references: [id])
  referrals            User[]          @relation("UserReferrals")
  branchId             String?
  branch               Branch?         @relation(fields: [branchId], references: [id])
  approvedTransfers    StockTransfer[] @relation("TransferApprover")
  createdTransfers     StockTransfer[] @relation("TransferCreator")

  @@index([role])
  @@index([branchId])
}

model Category {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  imageUrl         String?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  metaDescription  String?
  metaTitle        String?
  displayName      String?
  parentId         String?
  parent           Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories    Category[]        @relation("CategoryHierarchy")
  homePageSections HomePageSection[]
  products         Product[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model Product {
  id                      String              @id @default(cuid())
  sku                     String              @unique
  name                    String
  slug                    String              @unique
  description             String?
  imageUrl                String?
  images                  Json?
  price                   Decimal
  comparePrice            Decimal?
  costPrice               Decimal?
  weight                  Decimal?            @default(0)
  categoryId              String?
  stockQuantity           Int                 @default(0)
  reservedStock           Int                 @default(0)
  lowStockAlert           Int                 @default(5)
  status                  ProductStatus       @default(ACTIVE)
  options                 Json?
  isPreOrder              Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  isFeatured              Boolean             @default(false)
  requiresAgeVerification Boolean             @default(false)
  customBadge             String?
  unit                    String              @default("ширхэг")
  barcode                 String?             @unique
  cartItems               CartItem[]
  orderItems              OrderItem[]
  category                Category?           @relation(fields: [categoryId], references: [id])
  variants                ProductVariant[]
  inventories             Inventory[]
  transferItems           StockTransferItem[]
  stockMovements          StockMovement[]
  batches                 StockBatch[]

  @@index([status])
  @@index([categoryId])
  @@index([sku])
  @@index([barcode])
  @@index([slug])
  @@index([name])
}

model ProductVariant {
  id            String              @id @default(cuid())
  productId     String
  sku           String              @unique
  name          String
  options       Json
  price         Decimal?
  stockQuantity Int                 @default(0)
  imageUrl      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories   Inventory[]
  transferItems StockTransferItem[]

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String     @unique
  expiresAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]

  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Order {
  id                    String         @id @default(cuid())
  orderNumber           Int            @unique @default(autoincrement())
  idempotencyKey        String         @unique
  userId                String?
  customerName          String
  customerPhone         String
  accountNumber         String?
  subtotal              Decimal        @default(0)
  deliveryFee           Decimal        @default(0)
  discount              Decimal        @default(0)
  totalAmount           Decimal        @default(0)
  orderStatus           OrderStatus    @default(PENDING)
  deliveryAddress       String?
  deliveryDate          DateTime?
  wantsDelivery         Boolean        @default(false)
  stockReservedAt       DateTime?
  stockReleasedAt       DateTime?
  note                  String?
  cancellationReason    String?
  creationSource        CreationSource @default(WEB)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  allowSubstitution     Boolean        @default(true)
  companyRegistryNumber String?
  receiptType           String?        @default("individual")
  loyaltyAction         String?
  loyaltyCardNumber     String?
  loyaltyPointsEarned   Int            @default(0)
  loyaltyPointsUsed     Int            @default(0)
  referralRewardUsed    Int            @default(0)
  customerEmail         String?
  branchId              String?
  branch                Branch?        @relation(fields: [branchId], references: [id])
  user                  User?          @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  payments              Payment[]

  @@index([orderStatus])
  @@index([customerPhone])
  @@index([idempotencyKey])
  @@index([stockReservedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([branchId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  productName     String
  variantName     String?
  sku             String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal
  selectedOptions Json?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  amount          Decimal
  status          PaymentStatus @default(PENDING)
  externalRef     String?
  paidAt          DateTime?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastQpayCheckAt DateTime?
  qpayVerifiedAt  DateTime?
  qpayVerifiedBy  String?
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([externalRef])
  @@index([status])
  @@index([qpayVerifiedAt])
}

model ShopSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  userName  String
  userRole  String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model VerifiedPhone {
  phone      String   @id
  verifiedAt DateTime @default(now())
}

model VisitorLog {
  id        String   @id @default(cuid())
  ipHash    String?
  path      String
  userAgent String?
  referrer  String?
  viewTime  Int?     @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model Banner {
  id            String   @id @default(cuid())
  title         String?
  imageUrl      String
  linkUrl       String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  type          String   @default("HERO")
  showTitle     Boolean  @default(true)
  titleColor    String?  @default("#FFFFFF")
  titlePosition String?  @default("CENTER")
  titleSize     String?  @default("LARGE")

  @@index([isActive, type, sortOrder])
}

model LoyaltyCard {
  id            String   @id @default(cuid())
  cardNumber    String   @unique
  pointsBalance Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  phone         String?  @unique

  @@index([cardNumber])
  @@index([phone])
}

model HomePageSection {
  id                 String             @id @default(cuid())
  title              String
  type               SectionType        @default(PRODUCT_SLIDER)
  categoryId         String?
  bannerImageUrl     String?
  bannerLink         String?
  isActive           Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  autoScroll         Boolean            @default(false)
  rowCount           Int                @default(2)
  deviceTarget       DeviceTarget       @default(ALL)
  endDate            DateTime?
  layoutVariant      LayoutVariant      @default(DEFAULT)
  startDate          DateTime?
  visibilityTarget   VisibilityTarget   @default(ALL)
  bannerText         String?
  bannerTextColor    String?            @default("#FFFFFF")
  bannerTextPosition BannerTextPosition @default(TOP_LEFT)
  bannerTextSize     BannerTextSize     @default(LARGE)
  showBannerText     Boolean            @default(true)
  bannerPosition     String             @default("LEFT")
  category           Category?          @relation(fields: [categoryId], references: [id])

  @@index([isActive, sortOrder])
}

model SearchKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([count])
  @@index([keyword])
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
  CARGO_ADMIN
  DATAADMIN
  BRANCH_MANAGER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CreationSource {
  WEB
  ADMIN
  POS
  API
}

enum PaymentMethod {
  QPAY
  BANK_TRANSFER
  CASH
  CARD
  PAYLINK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SectionType {
  PRODUCT_SLIDER
  PROMO_SLIDER
  HERO_BANNER
  THIN_BANNER
  CATEGORY_MENU
  HOW_IT_WORKS
}

enum VisibilityTarget {
  ALL
  LOGGED_IN_ONLY
  GUEST_ONLY
}

enum DeviceTarget {
  ALL
  MOBILE_ONLY
  DESKTOP_ONLY
}

enum LayoutVariant {
  DEFAULT
  GRID
  MASONRY
}

enum BannerTextPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  BOTTOM_LEFT
  BOTTOM_CENTER
  BOTTOM_RIGHT
}

enum BannerTextSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TransferType {
  REGULAR
  RETURN
  DAMAGE_WRITE_OFF
}

enum MovementType {
  IN
  OUT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum BranchType {
  MAIN_WAREHOUSE
  STORE
}

model Branch {
  id        String     @id @default(cuid())
  name      String
  type      BranchType @default(STORE)
  address   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users         User[]
  orders        Order[]
  inventory     Inventory[]
  transfersFrom StockTransfer[] @relation("TransferFromBranch")
  transfersTo   StockTransfer[] @relation("TransferToBranch")
  movements     StockMovement[]
  batches       StockBatch[]
}

model Inventory {
  id            String   @id @default(cuid())
  branchId      String
  productId     String
  variantId     String?
  quantity      Int      @default(0)
  minStockLevel Int      @default(0)
  maxStockLevel Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId, variantId])
  @@index([branchId])
  @@index([productId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  referenceNumber String         @unique
  fromBranchId    String
  toBranchId      String
  status          TransferStatus @default(PENDING)
  type            TransferType   @default(REGULAR)
  note            String?

  createdById  String
  approvedById String?
  shippedAt    DateTime?
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromBranch Branch @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("TransferToBranch", fields: [toBranchId], references: [id])
  createdBy  User   @relation("TransferCreator", fields: [createdById], references: [id])
  approvedBy User?  @relation("TransferApprover", fields: [approvedById], references: [id])

  items     StockTransferItem[]
  movements StockMovement[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model StockTransferItem {
  id          String  @id @default(cuid())
  transferId  String
  productId   String
  variantId   String?
  quantity    Int
  receivedQty Int     @default(0)
  batchId     String?

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])
  batch    StockBatch?     @relation(fields: [batchId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model StockMovement {
  id         String       @id @default(cuid())
  branchId   String
  productId  String
  variantId  String?
  type       MovementType
  quantity   Int
  transferId String?
  orderId    String?
  batchId    String?
  note       String?
  createdAt  DateTime     @default(now())

  branch   Branch         @relation(fields: [branchId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  transfer StockTransfer? @relation(fields: [transferId], references: [id])
  batch    StockBatch?    @relation(fields: [batchId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([createdAt])
}

model StockBatch {
  id          String    @id @default(cuid())
  branchId    String
  productId   String
  variantId   String?
  batchNumber String
  expiryDate  DateTime?
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch        Branch              @relation(fields: [branchId], references: [id])
  product       Product             @relation(fields: [productId], references: [id])
  transferItems StockTransferItem[]
  movements     StockMovement[]

  @@index([branchId])
  @@index([productId])
  @@index([expiryDate])
}
