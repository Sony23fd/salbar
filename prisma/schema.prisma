// ==========================================
// Prisma Schema: Warehouse Management System
// Database: PostgreSQL (Neon / Supabase)
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ------------------------------------------
// Enums
// ------------------------------------------

enum Role {
  ADMIN
  WAREHOUSE_WORKER
  DELIVERY_DRIVER
  FINANCE
  PRODUCTION
}

enum BranchType {
  BRANCH
  CUSTOMER
}

enum TransactionType {
  INBOUND
  OUTBOUND
  ADJUSTMENT
}

// OrderStatus is now dynamic (stored in OrderStatusConfig)

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum MaterialType {
  RAW_MATERIAL      // Түүхий эд материал
  PACKAGING         // Сав баглаа боодол
  AUXILIARY         // Туслах материал
  SUPPLY            // Хангамжийн материал
  FINISHED_GOOD     // Бэлэн бүтээгдэхүүн
}

// ------------------------------------------
// User & Auth
// ------------------------------------------

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  password        String         @default("$2b$10$Epz0oN4hO3X5zY8A8R.5O.Xk7H/qF9OqHkZ1E/E8i2t9h1I9Y4Yq2") // Default to "password123" for existing rows, though we'll update seed
  role            Role           @default(WAREHOUSE_WORKER)
  permissions     String[]       @default([])
  isActive        Boolean        @default(true)
  createdOrders        Order[]                @relation("OrderCreator")
  deliveredOrders      Order[]                @relation("OrderDriver")
  historyLogs          OrderHistory[]         @relation("HistoryUser")
  inventoryTransactions InventoryTransaction[]
  
  createdTasks         Task[]                 @relation("TaskCreator")
  assignedTasks        Task[]                 @relation("TaskAssignee")
  taskComments         TaskComment[]
  
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@map("users")
}

// ------------------------------------------
// Branch Entity
// ------------------------------------------

model Branch {
  id             String    @id @default(cuid())
  name           String
  location       String
  contactPerson  String
  email          String
  phone          String
  type           BranchType @default(BRANCH)
  isActive       Boolean    @default(true)
  marginPercent  Float      @default(0)
  lastActivityAt DateTime  @default(now())
  orders         Order[]
  inventory      BranchInventory[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("branches")
}

model BranchInventory {
  id            String    @id @default(cuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Float       @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([branchId, productId])
  @@map("branch_inventory")
}

// ------------------------------------------
// Category & Product Inventory
// ------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id            String       @id @default(cuid())
  sku           String       @unique
  name          String
  description   String?
  unitPrice     Decimal      @db.Decimal(10, 2)
  costPrice     Decimal      @db.Decimal(10, 2) @default(0)
  unit          String       @default("ш")
  materialType  MaterialType @default(FINISHED_GOOD)
  stockQuantity Float          @default(0)
  stockSecondaryQuantity Float @default(0)
  initialStock  Float          @default(0) // Эхний үлдэгдэл
  minStockLevel Float          @default(5)
  isActive      Boolean      @default(true)
  
  categoryId    String?
  category      Category?              @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  transactions  InventoryTransaction[]
  branchStock   BranchInventory[]

  procurementItems      ProcurementItem[]
  bomHeader             BOM[]                   @relation("FinishedProductBOM")
  bomItems              BOMItem[]               @relation("IngredientProductBOM")
  productionBatches     ProductionBatch[]
  productionBatchItems  ProductionBatchItem[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@map("products")
}

// ------------------------------------------
// Inventory Transactions (History/Audit)
// ------------------------------------------

model InventoryTransaction {
  id            String          @id @default(cuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          TransactionType
  quantity      Float
  secondaryQuantity Float?
  previousStock Float
  newStock      Float
  previousSecondaryStock Float?
  newSecondaryStock      Float?
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  referenceId   String?         // Optional reference like Order Number
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([productId])
  @@index([type])
  @@map("inventory_transactions")
}

// ------------------------------------------
// Order & Items
// ------------------------------------------

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  status        String         @default("PENDING")
  totalAmount   Decimal        @db.Decimal(10, 2)
  baseTotalAmount Decimal      @db.Decimal(10, 2) @default(0)
  marginProfit  Decimal        @db.Decimal(10, 2) @default(0)
  createdById   String
  createdBy     User           @relation("OrderCreator", fields: [createdById], references: [id])
  deliveredById String?
  deliveredBy   User?          @relation("OrderDriver", fields: [deliveredById], references: [id])
  deliveredAt   DateTime?
  items         OrderItem[]
  history       OrderHistory[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@map("orders")
}

model OrderStatusConfig {
  id         String   @id @default(cuid())
  code       String   @unique
  label      String
  colorClass String
  orderIndex Int      @default(0)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("order_status_configs")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Decimal  @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

// ------------------------------------------
// Audit Trail & Detailed History Log
// ------------------------------------------

model OrderHistory {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedById   String
  changedBy     User        @relation("HistoryUser", fields: [changedById], references: [id])
  status        String
  notes         String?
  itemsSnapshot String      // JSON string of items & quantities at transition time
  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@map("order_histories")
}

// ------------------------------------------
// Task Management
// ------------------------------------------

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(TODO)
  dueDate       DateTime?
  
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId     String
  creator       User         @relation("TaskCreator", fields: [creatorId], references: [id])
  
  // Optional links to existing entities for context
  branchId      String?
  productId     String?
  orderId       String?
  
  // JSON strings for V2 features
  subtasks      String?      // JSON array of { id, title, completed }
  attachments   String?      // JSON array of { name, url, type }

  comments      TaskComment[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("tasks")
}

model TaskComment {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("task_comments")
}

// ------------------------------------------
// Bill of Materials (BOM / Жор)
// ------------------------------------------

model BOM {
  id                      String    @id @default(cuid())
  finishedProductId       String
  finishedProduct         Product   @relation("FinishedProductBOM", fields: [finishedProductId], references: [id], onDelete: Cascade)
  name                    String
  description             String?
  laborNormCost           Decimal   @db.Decimal(10, 2) @default(0)
  overheadAllocationCost  Decimal   @db.Decimal(10, 2) @default(0)
  targetProfitMargin      Float     @default(30)
  vatRate                 Float     @default(10)
  retailMarginRate        Float     @default(32)
  calculatedUnitCost      Decimal   @db.Decimal(10, 2) @default(0)
  suggestedRetailPrice    Decimal   @db.Decimal(10, 2) @default(0)
  items                   BOMItem[]
  
  // Tech Card Extensions
  version                 String    @default("v1.0")
  isApproved              Boolean   @default(false)
  preparationTimeMinutes  Int       @default(0)
  cookingTimeMinutes      Int       @default(0)
  shelfLifeDays           Int       @default(0)
  instructions            String?   @db.Text
  mediaUrls               String[]  @default([])
  allergens               String[]  @default([])
  nutritionInfo           String?   @db.Text
  steps                   TechCardStep[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("boms")
}

model BOMItem {
  id                String   @id @default(cuid())
  bomId             String
  bom               BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Product  @relation("IngredientProductBOM", fields: [ingredientId], references: [id])
  quantityPerUnit   Float
  grossQuantity     Float    @default(0)
  shrinkagePercent  Float    @default(0)
  itemCategory      String   @default("RAW_MATERIAL") // RAW_MATERIAL | PACKAGING | AUXILIARY

  @@map("bom_items")
}

model TechCardStep {
  id                String   @id @default(cuid())
  bomId             String
  bom               BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  stepNumber        Int
  title             String
  description       String?  @db.Text
  timeMinutes       Int      @default(0)
  temperature       Float?
  equipmentNeeded   String[] @default([])

  @@map("tech_card_steps")
}

// ------------------------------------------
// Deboning & Primary Processing (Шулаа ба Анхан шатны боловсруулалт)
// ------------------------------------------

model DeboningLog {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  animalType       String
  grossWeight      Float
  boneWasteWeight  Float
  netMeatWeight    Float
  yieldPercentage  Float
  notes            String?
  createdAt        DateTime @default(now())

  @@map("deboning_logs")
}

// ------------------------------------------
// Livestock Ledger (Малын тооцоо & Бой)
// ------------------------------------------

model LivestockLedger {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  receivedCount    Float      @default(0)
  slaughteredCount Float      @default(0)
  staffFoodCount   Float      @default(0)
  deadCount        Float      @default(0)
  soldCount        Float      @default(0)
  returnedCount    Float      @default(0)
  endingCount      Float      @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  @@map("livestock_ledgers")
}

// ------------------------------------------
// Procurement (Татан авалт)
// ------------------------------------------

model Procurement {
  id            String            @id @default(cuid())
  procurementNo String            @unique
  supplierName  String?
  notes         String?
  totalAmount   Decimal           @db.Decimal(10, 2)
  items         ProcurementItem[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("procurements")
}

model ProcurementItem {
  id            String      @id @default(cuid())
  procurementId String
  procurement   Procurement @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Float
  secondaryQuantity Float?
  unitPrice     Decimal     @db.Decimal(10, 2)
  totalPrice    Decimal     @db.Decimal(10, 2)
  expiryDate    DateTime?

  @@map("procurement_items")
}

// ------------------------------------------
// Production Batch & Costs (Үйлдвэрлэлийн Парц & Өртөг)
// ------------------------------------------

model ProductionBatch {
  id                  String                @id @default(cuid())
  batchNumber         String                @unique
  finishedProductId   String
  finishedProduct     Product               @relation(fields: [finishedProductId], references: [id])
  quantityProduced    Float
  fixedOverheadCost   Decimal               @db.Decimal(10, 2) @default(0)
  normalScrapAmount   Decimal               @db.Decimal(10, 2) @default(0)
  abnormalScrapAmount Decimal               @db.Decimal(10, 2) @default(0)
  totalMaterialCost   Decimal               @db.Decimal(10, 2) @default(0)
  totalProductionCost Decimal               @db.Decimal(10, 2) @default(0)
  calculatedUnitCost  Decimal               @db.Decimal(10, 2) @default(0)
  expiryDate          DateTime?
  notes               String?
  
  // Tech Card Batch Execution
  checklistStatus     String?               // JSON string tracking step completion
  scrapAnalysisAlert  Boolean               @default(false)

  items               ProductionBatchItem[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([finishedProductId])
  @@index([createdAt])
  @@map("production_batches")
}

model ProductionBatchItem {
  id                String          @id @default(cuid())
  productionBatchId String
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Product         @relation(fields: [ingredientId], references: [id])
  quantityUsed      Float
  unitPrice         Decimal         @db.Decimal(10, 2)
  totalPrice        Decimal         @db.Decimal(10, 2)

  @@map("production_batch_items")
}
